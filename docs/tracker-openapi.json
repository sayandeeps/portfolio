{
  "openapi": "3.0.3",
  "info": {
    "title": "Private Portfolio Tracker API",
    "version": "1.0.0",
    "description": "Manage the single-owner tracker board. PUT replaces the editable fields with submitted values and defaults. Revisions are board-wide. Supply If-Match on writes to reject stale CLI updates. Browser login is separate; the API requires TRACKER_API_TOKEN."
  },
  "servers": [
    {
      "url": "https://sayandeep.vercel.app/api/tracker"
    }
  ],
  "security": [
    {
      "trackerBearer": []
    }
  ],
