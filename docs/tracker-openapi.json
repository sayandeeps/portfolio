  "components": {
    "securitySchemes": {
      "trackerBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Opaque server-configured token of at least 32 characters."
      }
    },
    "schemas": {
      "ProjectInput": {
        "type": "object",
        "required": [
          "title",
          "category"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "category": {
            "enum": [
              "GitHub cleanup",
              "Data engineering",
              "Applied AI",
              "Fun",
              "Personal",
              "Teesverse"
            ]
          },
          "status": {
            "enum": [
              "Idea",
              "In progress",
              "Blocked",
              "Ready",
              "Published"
            ],
            "default": "Idea"
          },
          "priority": {
            "enum": [
              "Low",
              "Normal",
              "High"
            ],
            "default": "Normal"
          },
          "dueDate": {
            "type": "string",
            "description": "Empty string or YYYY-MM-DD.",
            "default": ""
          },
          "notes": {
            "type": "string",
            "maxLength": 2000,
            "default": ""
          }
        }
      },
      "Project": {
        "allOf": [
          {
            "$ref": "#/components/schemas/ProjectInput"
          },
          {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "updates": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Update"
                }
              }
            }
          }
        ]
      },
      "UpdateInput": {
        "type": "object",
        "required": [
          "message"
        ],
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      },
      "Update": {
        "allOf": [
          {
            "$ref": "#/components/schemas/UpdateInput"
          },
          {
            "type": "object",
            "required": [
              "id",
              "date"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "date": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
